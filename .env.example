DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PGDATABASE=kitobyor
PGUSER=kitobyor
PGPASSWORD=replace-with-a-database-password
PGHOST=127.0.0.1
PGPORT=5432

# Production domain and TLS email (Docker Compose + Caddy)
POSTGRES_ADMIN_PASSWORD=replace-with-a-separate-admin-password
KITOBYOR_DOMAIN=library.example.org
ACME_EMAIL=admin@example.org
CSRF_TRUSTED_ORIGINS=https://library.example.org
TRUST_PROXY_HEADERS=0
SECURE_HSTS_SECONDS=3600

# SMS without an HTTP provider API: physical GSM modem + SIM.
# preview never sends. gsm queues new real-school invoices for send_sms worker.
SMS_BACKEND=preview
SMS_MODEM_PORT=/dev/ttyUSB0
SMS_MODEM_BAUDRATE=115200
SMS_MODEM_TIMEOUT=45
SMS_DEVICE=/dev/ttyUSB0
SMS_DEVICE_GID=20
